{
  "name": "opsagent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:deployment-editor": "vite --open /fixtures/deployment-editor/",
    "dev:env-vars": "vite --open /fixtures/env-vars/",
    "dev:logs-redesign": "vite --open /fixtures/logs-redesign/",
    "dev:mounted-assets": "vite --open /fixtures/mounted-assets/",
    "dev:secret-editor": "vite --open /fixtures/secret-editor/",
    "dev:sessions-redesign": "vite --open /fixtures/sessions-redesign/",
    "dev:status-redesign": "vite --open /fixtures/status-redesign/",
    "check:secret-editor": "node fixtures/secret-editor/stateCheck.js",
    "check:deployment-editor": "node fixtures/deployment-editor/deploymentSourceCheck.js && node fixtures/deployment-editor/roundTripCheck.js",
    "test": "node --test src/state/deploymentMerge.test.js src/lib/agentSessions.test.js src/lib/envVarGrouping.test.js src/lib/nodeSpaces.test.js src/lib/valueExplorer.test.js src/lib/assetExplorer.test.js src/lib/authz.test.js src/hcl/index.test.js",
    "generate:hcl-parser": "node src/hcl/generate.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0",
    "vite": "7.1.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@scure/bip39": "^1.6.0",
    "@tailwindcss/vite": "^4.1.17",
    "codemirror": "^6.0.2",
    "tailwindcss": "^4.1.17",
    "vanjs-core": "^1.6.0",
    "vanjs-feather": "^0.1.7"
  }
