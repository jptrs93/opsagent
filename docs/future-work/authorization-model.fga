# OpenDeploy authorization model — design draft (OpenFGA DSL, schema 1.1).
#
# Scope decisions baked into this draft:
#   - Fixed roles, fixed object types. No custom roles, no per-tenant vocabulary.
#   - Spaces behave like folders: everything in a space inherits the space's
#     permissions. There are no per-resource grants yet, but the resource types
#     exist below so adding one later is a one-line change, not a remodel.
#   - Asset/secret/config directories are purely organisational and are
#     deliberately absent from the model.
#   - Out of scope for now: agent sessions as their own subject type (they act
#     as the user that approved them, narrowed by token scopes), nodes and
#     enrollments as objects (admin-only via `system`), per-resource overrides.
#
# Tuples the application would store:
#   system:main#admin@user:<id>            one per admin
#   space:<id>#system@system:main          one per space, written at space create
#   space:<id>#owner@user:<id>             role assignments, managed by owners
#   space:<id>#editor@user:<id>
#   space:<id>#viewer@user:<id>
#
# Resource->space links (deployment:42#space@space:1) never change after create
# (space moves are unsupported), so they can either be stored once at create or
# supplied as contextual tuples at check time straight from the primary DB —
# in which case the stored tuple set above is the entire authorization state.

model
  schema 1.1

type user

# `system` is a singleton (system:main) anchoring installation-wide roles.
# Every space links back to it, which is how admin folds into every space.
type system
  relations
    define admin: [user]

    # Per the fixed-role spec: only admins mint users and spaces.
    define can_create_user: admin
    define can_create_space: admin

    # Everything outside spaces (nodes, enrollments, settings, primary
    # updates) stays admin-only rather than getting object types of its own.
    define can_manage_cluster: admin
    define can_manage_settings: admin

type space
  relations
    define system: [system]

    # --- roles -------------------------------------------------------------
    # Strict hierarchy: admin > owner > editor > viewer. Each role is the
    # assignable set plus everything above it, so a single check on the
    # weakest sufficient role answers any question.
    define owner: [user] or admin from system
    define editor: [user] or owner
    define viewer: [user] or editor

    # --- the space itself ----------------------------------------------------
    define can_view: viewer
    define can_manage_members: owner
    # DECISION POINT: rename was unspecified; owner keeps it self-service.
    define can_rename: owner
    # Space delete is admin-only per the fixed-role spec.
    define can_delete: admin from system

    # --- deployments ---------------------------------------------------------
    # "edit" covers operating the deployment too (deploy, stop, rollover);
    # split out a `can_operate` verb later if operate-but-not-edit becomes a
    # real persona.
    define can_create_deployment: editor
    define can_view_deployments: viewer
    define can_edit_deployments: editor
    define can_delete_deployments: editor

    # --- secrets -------------------------------------------------------------
    # view = metadata (name, versions, usage); view values = plaintext reveal.
    # DECISION POINT: reveal is editor here on the theory that whoever rotates
    # a secret will need to read it; drop it to owner if reveal should be
    # rarer than rotate.
    define can_create_secret: editor
    define can_view_secrets: viewer
    define can_view_secret_values: editor
    define can_edit_secrets: editor
    define can_delete_secrets: editor

    # --- configs -------------------------------------------------------------
    # Config values are plaintext by design and ship with the metadata, so
    # there is no view/view-values split: viewing a config is viewing its
    # value.
    define can_create_config: editor
    define can_view_configs: viewer
    define can_edit_configs: editor
    define can_delete_configs: editor

    # --- assets --------------------------------------------------------------
    # edit covers publishing new versions, rename, and directory moves (the
    # directories themselves carry no permissions).
    define can_create_asset: editor
    define can_view_assets: viewer
    define can_edit_assets: editor
    define can_delete_assets: editor

# The resource types below are pure pass-throughs today: every verb forwards
# to the owning space, which is exactly the "things in a space inherit the
# space's permissions" rule. They exist anyway so that (a) enforcement code
# asks about the object actually being touched — check(user, can_edit,
# deployment:42) — and (b) a future per-resource exception is `[user] or ...`
# on one line here instead of a new model.

type deployment
  relations
    define space: [space]
    define can_view: can_view_deployments from space
    define can_edit: can_edit_deployments from space
    define can_delete: can_delete_deployments from space

type secret
  relations
    define space: [space]
    define can_view: can_view_secrets from space
    define can_view_value: can_view_secret_values from space
    define can_edit: can_edit_secrets from space
    define can_delete: can_delete_secrets from space

type config
  relations
    define space: [space]
    define can_view: can_view_configs from space
    define can_edit: can_edit_configs from space
    define can_delete: can_delete_configs from space

type asset
  relations
    define space: [space]
    define can_view: can_view_assets from space
    define can_edit: can_edit_assets from space
    define can_delete: can_delete_assets from space
