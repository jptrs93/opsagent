# Initial bootstrap password hash. Fresh primary installs replace this with a
# generated temporary password hash and print the password once.
OPENDEPLOY_INITIAL_MASTER_PASSWORD_HASH=go5YFJGzqKmB7x70xNCHO62h9ledaB8c2wvmzalyZR/b6ZKRKHctSJsMV6ob0F8N
OPENDEPLOY_INITIAL_ACME_HOSTS=opendeploy.example.com
OPENDEPLOY_INITIAL_ACME_EMAIL=
OPENDEPLOY_INITIAL_WEB_HTTPS_ENABLED=true
OPENDEPLOY_INITIAL_WEB_HTTPS_LISTEN=:443
OPENDEPLOY_INITIAL_WEB_HTTP_ENABLED=false
OPENDEPLOY_INITIAL_WEB_HTTP_LISTEN=:8080
OPENDEPLOY_INITIAL_WEB_TLS_SELF_MANAGED=false
OPENDEPLOY_INITIAL_WEB_TLS_CERT_PEM_FILE=
OPENDEPLOY_PASSKEY_EXTRA_ORIGINS=

# Cluster mTLS — primary key material is generated on first startup and stored
# encrypted in the primary secrets store. Workers receive local TLS files via
# HTTPS enrollment. Workers generate their private key locally and send a CSR.
OPENDEPLOY_INITIAL_CLUSTER_LISTEN=:9443
OPENDEPLOY_INITIAL_ENROLLMENT_LISTEN=:9444
# For worker nodes only — set to the primary's addresses:
# OPENDEPLOY_PRIMARY_CLUSTER_ADDR=10.0.0.1:9443
# OPENDEPLOY_PRIMARY_ENROLLMENT_ADDR=10.0.0.1:9444
# OPENDEPLOY_PRIMARY_ENROLLMENT_FINGERPRINT=sha256:<hex>
