[Unit]
Description=OpenDeploy deployment management server
After=network-online.target opendeploy-containerd.service
Wants=network-online.target opendeploy-containerd.service

[Service]
Type=simple
User=root
Group=root

ExecStart=/var/lib/opendeploy/bin/opendeploy primary

# Environment — override via /etc/opendeploy/env or systemctl edit
EnvironmentFile=-/etc/opendeploy/env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Only signal the main opendeploy process on stop/restart.
KillMode=process

# OpenDeploy can exit cleanly for managed lifecycle events, such as applying
# listener config changes by starting again from a fresh config snapshot.
Restart=always
RestartSec=5

# The agent runs as root: it manages containers, network namespaces, nftables
# and its own unit. Nothing it starts needs to gain privilege on exec.
NoNewPrivileges=yes
# Options that give the service a private mount namespace (PrivateTmp,
# ProtectSystem, ProtectHome, ProtectKernelLogs) must stay off: the agent
# bind-mounts named network namespaces under /run/netns, and containerd has to
# see them.

[Install]
WantedBy=multi-user.target
