# Generate a hash with: cd backend && go run ./cmd/genhash
OPENDEPLOY_MASTER_PASSWORD_HASH=
OPENDEPLOY_GITHUB_TOKEN=
OPENDEPLOY_ACME_HOSTS=opendeploy.example.com
OPENDEPLOY_ACME_EMAIL=
OPENDEPLOY_HTTP_ONLY=false

# Cluster mTLS — primary key material is generated on first startup and stored
# encrypted in the primary secrets store. Workers receive local TLS files via
# enrollment.
OPENDEPLOY_CLUSTER_LISTEN=:9443
OPENDEPLOY_ENROLLMENT_LISTEN=:9444
# For worker nodes only — set to the primary's address:
# OPENDEPLOY_PRIMARY_ADDR=10.0.0.1:9443
