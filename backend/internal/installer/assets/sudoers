# Allow the opendeploy user to manage its own service without a password.
# systemctl is used for stop/start; systemd-run is used for restart so
# that self-restarts don't get caught in the cgroup teardown.
opendeploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart opendeploy.service
opendeploy ALL=(root) NOPASSWD: /usr/bin/systemctl stop opendeploy.service
opendeploy ALL=(root) NOPASSWD: /usr/bin/systemctl start opendeploy.service
opendeploy ALL=(root) NOPASSWD: /usr/bin/systemd-run --no-block /usr/bin/systemctl restart opendeploy.service
# Also allow restarting the bundled containerd, so a runtime binary bump can
# take effect without a separate root login.
opendeploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart opendeploy-containerd.service
