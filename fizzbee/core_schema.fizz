---
options:
  max_actions: 6
  max_concurrent_actions: 1
deadlock_detection: false
liveness: "false"
---

FAMILIES = ('secret', 'config', 'asset')
SYSTEM_SPACE = 0
GLOBAL_SPACE = 1
MAX_SPACE_ID = 2
MAX_ENTITIES = 2
MAX_VERSIONS = 2
MAX_DEPLOYMENTS = 2
MAX_DEPLOYMENT_VERSIONS = 3
MAX_INSTANCES = 2
NODES = (1,)
ORDINALS = (0,)

atomic func current_value_space(family, id):
    space = 0
    for e in value_space_log[family]:
        if e.owner == id:
            space = e.space
    return space

atomic func pin_candidates(family, space):
    out = [None]
    for row in value_versions[family]:
        v = value_versions[family][row]
        if not value_entities[family][v.owner].deleted:
            owner_space = current_value_space(family, v.owner)
            if owner_space == space or owner_space == GLOBAL_SPACE:
                out.append(row)
    return out

action Init:
    global_seq = 0
    spaces = set([SYSTEM_SPACE, GLOBAL_SPACE])
    next_space_id = 2
    value_entities = {'secret': {}, 'config': {}, 'asset': {}}
    value_versions = {'secret': {}, 'config': {}, 'asset': {}}
    value_space_log = {'secret': [], 'config': [], 'asset': []}
    next_value_id = {'secret': 1, 'config': 1, 'asset': 1}
    next_value_version_row_id = {'secret': 1, 'config': 1, 'asset': 1}
    deployments = {}
    deployment_versions = {}
    deployment_space_versions = {}
    next_deployment_id = 1
    next_space_version_row_id = 1
    scheduled_instances = {}
    next_instance_id = 1

atomic action CreateSpace:
    require next_space_id <= MAX_SPACE_ID
    spaces.add(next_space_id)
    next_space_id = next_space_id + 1

atomic action DeleteSpace:
    s = oneof [x for x in spaces if x != SYSTEM_SPACE and x != GLOBAL_SPACE]
    blocked = False
    for d in deployments:
        if not deployments[d].deleted:
            dlog = deployment_space_versions[d]
            if dlog[len(dlog) - 1].space == s:
                blocked = True
    require not blocked
    spaces.discard(s)

atomic action CreateValue:
    family = oneof FAMILIES
    require next_value_id[family] <= MAX_ENTITIES
    space = oneof [x for x in spaces if x != SYSTEM_SPACE]
    global_seq = global_seq + 1
    id = next_value_id[family]
    next_value_id[family] = id + 1
    value_entities[family][id] = record(deleted=False, nversions=1)
    value_space_log[family].append(record(owner=id, space=space, seq=global_seq))
    row = next_value_version_row_id[family]
    next_value_version_row_id[family] = row + 1
    value_versions[family][row] = record(owner=id, version=1, seq=global_seq)

atomic action AppendValueVersion:
    family = oneof FAMILIES
    candidates = [id for id in value_entities[family] if not value_entities[family][id].deleted and value_entities[family][id].nversions < MAX_VERSIONS]
    id = oneof candidates
    global_seq = global_seq + 1
    e = value_entities[family][id]
    e.nversions = e.nversions + 1
    row = next_value_version_row_id[family]
    next_value_version_row_id[family] = row + 1
    value_versions[family][row] = record(owner=id, version=e.nversions, seq=global_seq)
    if family != 'asset':
        for d in deployments:
            if not deployments[d].deleted:
                vlog = deployment_versions[d]
                spec = vlog[len(vlog) - 1]
                pin = spec.secret_pin if family == 'secret' else spec.config_pin
                rotate = False
                if pin != None:
                    if value_versions[family][pin].owner == id:
                        rotate = True
                if rotate:
                    if family == 'secret':
                        vlog.append(record(version=spec.version + 1, seq=global_seq, secret_pin=row, config_pin=spec.config_pin, asset_pin=spec.asset_pin))
                    else:
                        vlog.append(record(version=spec.version + 1, seq=global_seq, secret_pin=spec.secret_pin, config_pin=row, asset_pin=spec.asset_pin))

atomic action MoveValueSpace:
    family = oneof FAMILIES
    candidates = [id for id in value_entities[family] if not value_entities[family][id].deleted]
    id = oneof candidates
    dest = oneof [x for x in spaces if x != SYSTEM_SPACE]
    cur = current_value_space(family, id)
    require dest != cur
    if dest != GLOBAL_SPACE:
        blocked = False
        for d in deployments:
            if not deployments[d].deleted:
                dlog = deployment_space_versions[d]
                dspace = dlog[len(dlog) - 1].space
                if dspace != dest:
                    vlog = deployment_versions[d]
                    spec = vlog[len(vlog) - 1]
                    if family == 'secret':
                        pin = spec.secret_pin
                    elif family == 'config':
                        pin = spec.config_pin
                    else:
                        pin = spec.asset_pin
                    if pin != None:
                        if value_versions[family][pin].owner == id:
                            blocked = True
        require not blocked
    global_seq = global_seq + 1
    value_space_log[family].append(record(owner=id, space=dest, seq=global_seq))

atomic action SoftDeleteValue:
    family = oneof FAMILIES
    candidates = [id for id in value_entities[family] if not value_entities[family][id].deleted]
    id = oneof candidates
    value_entities[family][id].deleted = True

atomic action CreateDeployment:
    require next_deployment_id <= MAX_DEPLOYMENTS
    node = oneof NODES
    space = oneof [x for x in spaces if x != SYSTEM_SPACE]
    secret_cands = pin_candidates('secret', space)
    config_cands = pin_candidates('config', space)
    asset_cands = pin_candidates('asset', space)
    secret_pin = oneof secret_cands
    config_pin = oneof config_cands
    asset_pin = oneof asset_cands
    global_seq = global_seq + 1
    d = next_deployment_id
    next_deployment_id = d + 1
    deployments[d] = record(node=node, deleted=False)
    deployment_versions[d] = [record(version=1, seq=global_seq, secret_pin=secret_pin, config_pin=config_pin, asset_pin=asset_pin)]
    row = next_space_version_row_id
    next_space_version_row_id = row + 1
    deployment_space_versions[d] = [record(row_id=row, version=1, space=space, seq=global_seq)]

atomic action UpdateDeploymentSpec:
    candidates = [d for d in deployments if not deployments[d].deleted and len(deployment_versions[d]) < MAX_DEPLOYMENT_VERSIONS]
    d = oneof candidates
    dlog = deployment_space_versions[d]
    space = dlog[len(dlog) - 1].space
    secret_cands = pin_candidates('secret', space)
    config_cands = pin_candidates('config', space)
    asset_cands = pin_candidates('asset', space)
    secret_pin = oneof secret_cands
    config_pin = oneof config_cands
    asset_pin = oneof asset_cands
    global_seq = global_seq + 1
    vlog = deployment_versions[d]
    vlog.append(record(version=vlog[len(vlog) - 1].version + 1, seq=global_seq, secret_pin=secret_pin, config_pin=config_pin, asset_pin=asset_pin))

atomic action MoveDeploymentSpace:
    candidates = [d for d in deployments if not deployments[d].deleted]
    d = oneof candidates
    dest = oneof [x for x in spaces if x != SYSTEM_SPACE]
    dlog = deployment_space_versions[d]
    cur = dlog[len(dlog) - 1].space
    require dest != cur
    vlog = deployment_versions[d]
    spec = vlog[len(vlog) - 1]
    ok = True
    for family in FAMILIES:
        if family == 'secret':
            pin = spec.secret_pin
        elif family == 'config':
            pin = spec.config_pin
        else:
            pin = spec.asset_pin
        if pin != None:
            owner = value_versions[family][pin].owner
            owner_space = current_value_space(family, owner)
            if owner_space != dest and owner_space != GLOBAL_SPACE:
                ok = False
    require ok
    global_seq = global_seq + 1
    row = next_space_version_row_id
    next_space_version_row_id = row + 1
    dlog.append(record(row_id=row, version=dlog[len(dlog) - 1].version + 1, space=dest, seq=global_seq))

atomic action SoftDeleteDeployment:
    candidates = [d for d in deployments if not deployments[d].deleted]
    d = oneof candidates
    global_seq = global_seq + 1
    deployments[d].deleted = True
    vlog = deployment_versions[d]
    last = vlog[len(vlog) - 1]
    vlog.append(record(version=last.version + 1, seq=global_seq, secret_pin=last.secret_pin, config_pin=last.config_pin, asset_pin=last.asset_pin))

atomic action ScheduleInstance:
    require next_instance_id <= MAX_INSTANCES
    candidates = [d for d in deployments if not deployments[d].deleted]
    d = oneof candidates
    vlog = deployment_versions[d]
    version = vlog[len(vlog) - 1].version
    node = deployments[d].node
    ordinal = oneof ORDINALS
    dup = False
    for i in scheduled_instances:
        inst = scheduled_instances[i]
        if inst.deployment == d and inst.deployment_version == version and inst.node == node and inst.ordinal == ordinal:
            dup = True
    require not dup
    dlog = deployment_space_versions[d]
    global_seq = global_seq + 1
    scheduled_instances[next_instance_id] = record(deployment=d, deployment_version=version, node=node, ordinal=ordinal, space_version_row_id=dlog[len(dlog) - 1].row_id, seq=global_seq)
    next_instance_id = next_instance_id + 1

always assertion ValueLogsConsistent:
    for family in FAMILIES:
        for id in value_entities[family]:
            nversions = 0
            for r in value_versions[family]:
                if value_versions[family][r].owner == id:
                    nversions = nversions + 1
            nspaces = 0
            for e in value_space_log[family]:
                if e.owner == id:
                    nspaces = nspaces + 1
            if nversions < 1 or nspaces < 1 or nversions != value_entities[family][id].nversions:
                return False
    return True

always assertion ValueVersionRowOrderAgrees:
    for family in FAMILIES:
        for r1 in value_versions[family]:
            for r2 in value_versions[family]:
                v1 = value_versions[family][r1]
                v2 = value_versions[family][r2]
                if v1.owner == v2.owner and r1 < r2 and v1.version >= v2.version:
                    return False
    return True

always assertion ValuesNeverInSystemSpace:
    for family in FAMILIES:
        for e in value_space_log[family]:
            if e.space == SYSTEM_SPACE:
                return False
    return True

always assertion DeploymentLogsNonEmpty:
    for d in deployments:
        if len(deployment_versions[d]) < 1 or len(deployment_space_versions[d]) < 1:
            return False
    return True

always assertion DeploymentCreationAtomic:
    for d in deployments:
        if deployment_versions[d][0].seq != deployment_space_versions[d][0].seq:
            return False
    return True

always assertion DeploymentPinsResolve:
    for d in deployments:
        for spec in deployment_versions[d]:
            if spec.secret_pin != None and spec.secret_pin not in value_versions['secret']:
                return False
            if spec.config_pin != None and spec.config_pin not in value_versions['config']:
                return False
            if spec.asset_pin != None and spec.asset_pin not in value_versions['asset']:
                return False
    return True

always assertion LiveDeploymentPinLocality:
    for d in deployments:
        if not deployments[d].deleted:
            dlog = deployment_space_versions[d]
            dspace = dlog[len(dlog) - 1].space
            vlog = deployment_versions[d]
            spec = vlog[len(vlog) - 1]
            pins = {'secret': spec.secret_pin, 'config': spec.config_pin, 'asset': spec.asset_pin}
            for family in pins:
                pin = pins[family]
                if pin != None:
                    owner = value_versions[family][pin].owner
                    owner_space = 0
                    for e in value_space_log[family]:
                        if e.owner == owner:
                            owner_space = e.space
                    if owner_space != dspace and owner_space != GLOBAL_SPACE:
                        return False
    return True

always assertion LiveDeploymentSpaceExists:
    for d in deployments:
        if not deployments[d].deleted:
            dlog = deployment_space_versions[d]
            if dlog[len(dlog) - 1].space not in spaces:
                return False
    return True

always assertion SeqStampsBounded:
    for family in FAMILIES:
        for r in value_versions[family]:
            if value_versions[family][r].seq < 1 or value_versions[family][r].seq > global_seq:
                return False
        for e in value_space_log[family]:
            if e.seq < 1 or e.seq > global_seq:
                return False
    for d in deployments:
        for spec in deployment_versions[d]:
            if spec.seq < 1 or spec.seq > global_seq:
                return False
        for e in deployment_space_versions[d]:
            if e.seq < 1 or e.seq > global_seq:
                return False
    for i in scheduled_instances:
        if scheduled_instances[i].seq < 1 or scheduled_instances[i].seq > global_seq:
            return False
    return True

always assertion ValueCreationAtomic:
    for family in FAMILIES:
        for id in value_entities[family]:
            v1seq = 0
            for r in value_versions[family]:
                v = value_versions[family][r]
                if v.owner == id and v.version == 1:
                    v1seq = v.seq
            s1seq = -1
            for e in value_space_log[family]:
                if e.owner == id and s1seq == -1:
                    s1seq = e.seq
            if v1seq != s1seq:
                return False
    return True

always assertion InstancePinsResolve:
    for i in scheduled_instances:
        inst = scheduled_instances[i]
        if inst.deployment not in deployments:
            return False
        version_found = False
        for spec in deployment_versions[inst.deployment]:
            if spec.version == inst.deployment_version:
                version_found = True
        row_found = False
        for e in deployment_space_versions[inst.deployment]:
            if e.row_id == inst.space_version_row_id:
                row_found = True
        if not version_found or not row_found:
            return False
    return True

always assertion InstanceIncarnationUnique:
    for i in scheduled_instances:
        for j in scheduled_instances:
            if i < j:
                a = scheduled_instances[i]
                b = scheduled_instances[j]
                if a.deployment == b.deployment and a.deployment_version == b.deployment_version and a.node == b.node and a.ordinal == b.ordinal:
                    return False
    return True

exists assertion InstanceScheduled:
    return len(scheduled_instances) > 0

exists assertion CrossSpaceGlobalReference:
    for d in deployments:
        if not deployments[d].deleted:
            dlog = deployment_space_versions[d]
            dspace = dlog[len(dlog) - 1].space
            if dspace != GLOBAL_SPACE:
                vlog = deployment_versions[d]
                spec = vlog[len(vlog) - 1]
                pins = {'secret': spec.secret_pin, 'config': spec.config_pin, 'asset': spec.asset_pin}
                for family in pins:
                    pin = pins[family]
                    if pin != None:
                        owner = value_versions[family][pin].owner
                        owner_space = 0
                        for e in value_space_log[family]:
                            if e.owner == owner:
                                owner_space = e.space
                        if owner_space == GLOBAL_SPACE:
                            return True
    return False

exists assertion ValueSpaceCanDangle:
    for family in FAMILIES:
        for id in value_entities[family]:
            owner_space = 0
            for e in value_space_log[family]:
                if e.owner == id:
                    owner_space = e.space
            if owner_space not in spaces:
                return True
    return False
